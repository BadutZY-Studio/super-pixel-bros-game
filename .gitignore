# ==========================================================
# Super Pixel Bros (Mobile) - Godot 4.x
# ==========================================================

# Cache dan data internal editor Godot (dibuat ulang otomatis)
.godot/
.nomedia

# File .import dan .uid TIDAK di-ignore.
# Keduanya harus ikut di-commit agar pengaturan import aset
# dan referensi skrip tetap konsisten di semua perangkat.

# Override pengaturan editor/proyek lokal
export_credentials.cfg
*.tmp
*.translation

# Hasil export (Android dan iOS)
*.apk
*.aab
*.idsig
*.ipa
*.xcarchive
*.pck
build/
builds/
export/
exports/
dist/

# Template build Android (dibuat oleh "Install Android Build Template")
android/build/
android/.gradle/
.gradle/
local.properties
*.iml

# Kunci dan sertifikat penandatanganan (jangan pernah di-commit)
*.keystore
*.jks
*.p12
*.pfx
*.pem
*.key
*.mobileprovision
*.cer

# Hasil export desktop (jika ikut dites dari proyek ini)
*.exe
*.x86_64
*.app
*.dmg

# Mono / C# (jika suatu saat dipakai)
.mono/
data_*/
mono_crash.*.json

# Skrip Python di folder tools
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# File sementara dan log
*.log
*.bak
*.swp
*~

# Editor dan IDE
.vscode/
.idea/
*.code-workspace

# File sistem operasi
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/